<?xml version="1.0" encoding="utf-8"?>
<project>
	<meta title="Journey to the Thingamajig" package="com.ethanfischer.jttt" version="2.0.0" company="Ethan Fischer" />

	<app main="Main" path="export" file="JourneyToTheThingamajig" />

	<window width="800" height="400" fps="60" background="#000000" hardware="true" vsync="false" />
	<window width="640" height="480" fps="60" if="html5" />

	<source path="source" />

	<haxelib name="flixel" />
	<haxelib name="flixel-addons" />

	<assets path="assets" />
	<assets path="map" rename="map" />

	<haxedef name="FLX_NO_DEBUG" unless="debug" />
	<haxedef name="FLX_HEALTH" />

	<icon path="assets/icon.png" />
</project>
